API_PORT=5070
# MongoDB connection string without the database name; MONGODB_DB is appended.
# You can reuse the same cluster as Tone Radar — just keep a different MONGODB_DB.
# Leave empty to run without accounts (cities still save in the browser).
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
MONGODB_DB=citybuilder
JWT_SECRET=a_long_random_string
JWT_EXPIRES_IN=7d
